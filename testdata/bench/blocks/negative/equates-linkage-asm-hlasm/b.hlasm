* Block-clone NEGATIVE fixture (negative/equates-linkage-asm-hlasm), b side.
         TITLE 'INVSCAN - ITEMS BELOW THE REORDER POINT'
         PRINT NOGEN
INVSCAN  CSECT
         EXTRN ORDRQ,INVLOG
         STM   R14,R12,12(R13)
         BALR  R12,0
         USING *,R12
         ST    R13,SAVEAREA+4
         LA    R13,SAVEAREA
         LM    R3,R5,0(R1)        A(table), A(entry len), A(last)
         L     R4,0(,R4)
         L     R5,0(,R5)
         SR    R6,R6              items to reorder
         USING ITEM,R3
SCAN     CP    ITEMQOH,ITEMROP    on hand below reorder point?
         BNL   NEXT
         LA    R6,1(,R6)
         MVC   ORDKEY,ITEMKEY
         LA    R1,ORDPARM
         L     R15,=V(ORDRQ)
         BALR  R14,R15            queue a reorder
NEXT     BXLE  R3,R4,SCAN
         LR    R15,R6             rc = number queued
         L     R13,SAVEAREA+4
         L     R14,12(,R13)
         LM    R0,R12,20(R13)
         BR    R14
         EJECT
SAVEAREA DS    18F
ORDPARM  DC    A(ORDKEY)
ORDKEY   DS    CL8
         LTORG
R0       EQU   0
R1       EQU   1
R2       EQU   2
R3       EQU   3
R4       EQU   4
R5       EQU   5
R6       EQU   6
R7       EQU   7
R8       EQU   8
R9       EQU   9
R10      EQU   10
R11      EQU   11
R12      EQU   12
R13      EQU   13
R14      EQU   14
R15      EQU   15
INVDEL   EQU   X'80'              item is discontinued
INVHOLD  EQU   X'40'              item is on hold
INVNEW   EQU   X'20'              new this season
MAXITEMS EQU   5000
ORDMIN   EQU   12
ITEMLEN  EQU   ITEMEND-ITEM
ITEM     DSECT
ITEMKEY  DS    CL8
ITEMQOH  DS    PL4
ITEMROP  DS    PL4
ITEMEND  EQU   *
         END   INVSCAN
