*--------------------------------------------------------------------*  00010000
* COUNTREC  COUNT THE RECORDS IN THE INPUT FILE AND REPORT THE TOTAL *  00020000
*--------------------------------------------------------------------*  00030000
COUNTREC CSECT                                                          00040000
         STM   14,12,12(13)       SAVE CALLER REGISTERS                 00050000
         BALR  12,0               ESTABLISH ADDRESSABILITY              00060000
         USING *,12                                                     00070000
         ST    13,SAVEAREA+4      CHAIN THE SAVE AREAS                  00080000
         LA    13,SAVEAREA                                              00090000
         OPEN  (INDCB,(INPUT))    OPEN THE INPUT FILE                   00100000
         SR    3,3                RECORD COUNT = 0                      00110000
READ     GET   INDCB,RECORD       NEXT RECORD                           00120000
         LA    3,1(,3)            COUNT IT                              00130000
         B     READ                                                     00140000
EOF      CLOSE (INDCB)            END OF FILE                           00150000
         CVD   3,DWORK            CONVERT THE COUNT                     00160000
         UNPK  MSGCNT,DWORK       TO ZONED DECIMAL                      00170000
         OI    MSGCNT+7,X'F0'     MAKE THE LAST DIGIT PRINTABLE         00180000
         WTO   MF=(E,MSG)         REPORT THE COUNT                      00190000
         L     13,SAVEAREA+4      RESTORE CALLER SAVE AREA              00200000
         LM    14,12,12(13)       RESTORE REGISTERS                     00210000
         SR    15,15              RETURN CODE 0                         00220000
         BR    14                                                       00230000
SAVEAREA DS    18F                                                      00240000
DWORK    DS    D                                                        00250000
RECORD   DS    CL80                                                     00260000
MSG      DC    AL2(MSGEND-MSG),AL2(0)                                   00270000
         DC    C'RECORDS READ: '                                        00280000
MSGCNT   DS    CL8                                                      00290000
MSGEND   EQU   *                                                        00300000
INDCB    DCB   DDNAME=INPUT,DSORG=PS,MACRF=GM,EODAD=EOF,RECFM=FB,      X00310000
               LRECL=80                                                 00320000
         END   COUNTREC                                                 00330000
